# Copy to .env. Everything defaults to offline mode; no keys are required.
RAG_APP_ENV=development
RAG_LOG_LEVEL=INFO

# Pipeline served by the API (the UI can override the retriever per request)
RAG_CHUNKER=recursive            # fixed | recursive | sentence
RAG_RETRIEVER=hybrid-rerank      # bm25 | dense | hybrid | hybrid-rerank
RAG_TOP_K=5
RAG_AUTOLOAD_CORPUS=true         # index data/corpus on startup
# RAG_CORPUS_DIR=data/corpus
# RAG_RUNS_DIR=runs

# Answer generation: fake = offline extractive answerer
RAG_LLM_PROVIDER=fake            # fake | openai | anthropic | ollama
RAG_LLM_MODEL=
RAG_LLM_BASE_URL=                # defaults per provider, e.g. http://localhost:11434 for ollama
RAG_LLM_API_KEY=

# Dense retrieval: hashed = offline hashed n-gram TF-IDF vectors
RAG_EMBEDDINGS_PROVIDER=hashed   # hashed | openai | ollama
RAG_EMBEDDINGS_MODEL=
RAG_EMBEDDINGS_BASE_URL=
RAG_EMBEDDINGS_API_KEY=

# Vector store: memory, or pgvector (needs `pip install '.[pgvector]'`)
RAG_VECTOR_STORE=memory
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
